{
  "name": "backend",
  "version": "1.0.0",
  "description": "Maker Collective voting API",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --envPath .env",
    "db:seed": "node db/seeds/initial-data.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
