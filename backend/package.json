  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  }
}
