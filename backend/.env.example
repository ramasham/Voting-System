PORT=3000
NODE_ENV=development
# Local examples only. Replace with venue-approved CIDRs for deployment.
ALLOWED_IP_RANGES=127.0.0.1/32,::1/128

# In-memory rate limits: maximum requests per window per IP.
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
VOTE_RATE_LIMIT_MAX=30
VOTE_RATE_LIMIT_WINDOW_MS=60000
