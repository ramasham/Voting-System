NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
# Size each app instance so the combined pool stays below PostgreSQL's connection budget.
# Direct connections: 0. Behind a proxy: explicitly trust only its IP/CIDR.
TRUST_PROXY=0

# Generate four independent secrets, e.g. openssl rand -hex 32.
OTP_HMAC_SECRET=replace-me-with-a-random-secret-at-least-32-characters
VISITOR_TOKEN_SECRET=replace-me-with-a-random-secret-at-least-32-characters
ADMIN_TOKEN_SECRET=replace-me-with-a-random-secret-at-least-32-characters
RATE_LIMIT_HMAC_SECRET=replace-me-with-a-random-secret-at-least-32-characters

# Console prints codes locally and is forbidden in production.
SMS_PROVIDER=console
# Production SMS adapter; CPF must provision a provider before the pilot.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+...
# TWILIO_MESSAGING_SERVICE_SID=MG...

# Shared PostgreSQL limits. Coarse IP caps accommodate shared venue Wi-Fi;
# registration also limits each phone to 3 codes per 15 minutes.
OTP_REGISTER_IP_MAX=3000
OTP_VERIFY_IP_MAX=6000
VOTE_RATE_LIMIT_MAX=30
VOTE_RATE_LIMIT_WINDOW_MS=60000

# Venue CIDRs, location policy, categories, schedules and open/close state live
# in event_settings, configured through authenticated admin APIs.
